# Copy to .env.local and fill in. Never commit .env.local.

# ─── Database ───
# Neon (recommended): https://console.neon.tech → create project → copy string
# Local Docker: postgres://repocrawler:repocrawler@localhost:5432/repocrawler
DATABASE_URL=

# ─── Auth (NextAuth v5) ───
# Generate: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth App
# Create at: https://github.com/settings/developers → New OAuth App
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:3000/api/auth/callback/github
# Request scopes: public_repo, read:user, user:email
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ─── Analysis pipeline — set ONE of these ───
# Google Gemini (FREE, recommended for dev): https://aistudio.google.com/apikey
# Free tier: 1,500 requests/day, no credit card.
GOOGLE_API_KEY=

# Anthropic (paid): https://console.anthropic.com/settings/keys
# Used only if GOOGLE_API_KEY is not set.
ANTHROPIC_API_KEY=

# GitHub Personal Access Token — only used by scripts/eval.ts
# https://github.com/settings/tokens → classic → scopes: public_repo
GITHUB_TOKEN=

# ─── Phase 5+ (not required yet) ───
VOYAGE_API_KEY=
REDIS_URL=
